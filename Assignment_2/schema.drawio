        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    FARMERS ||--o{ PRODUCTS : lists\n    CATEGORIES ||--o{ PRODUCTS : classifies\n\n    BUYERS ||--o{ ORDERS : places\n    ORDERS ||--|{ ORDER_ITEMS : contains\n    PRODUCTS ||--o{ ORDER_ITEMS : references\n\n    ORDERS ||--o{ PAYMENTS : has\n    ORDERS ||--o| DELIVERIES : generates\n    DELIVERIES ||--o{ TRACKING_EVENTS : records\n\n    FARMERS {\n        int farmer_id PK\n        string name\n        string phone\n        string location\n    }\n\n    CATEGORIES {\n        int category_id PK\n        string name\n    }\n\n    PRODUCTS {\n        int product_id PK\n        int farmer_id FK\n        int category_id FK\n        string name\n        decimal price\n        decimal quantity\n        string unit\n    }\n\n    BUYERS {\n        int buyer_id PK\n        string name\n        string phone\n        string address\n    }\n\n    ORDERS {\n        int order_id PK\n        int buyer_id FK\n        string status\n        decimal total_amount\n        datetime created_at\n    }\n\n    ORDER_ITEMS {\n        int order_item_id PK\n        int order_id FK\n        int product_id FK\n        decimal quantity\n        decimal unit_price\n    }\n\n    PAYMENTS {\n        int payment_id PK\n        int order_id FK\n        decimal amount\n        string status\n        string transaction_ref\n    }\n\n    DELIVERIES {\n        int delivery_id PK\n        int order_id FK\n        string status\n        string tracking_number\n    }\n\n    TRACKING_EVENTS {\n        int event_id PK\n        int delivery_id FK\n        string location\n        string description\n        datetime event_time\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nNaAcR__XKqrvP9yqQPy-1">
